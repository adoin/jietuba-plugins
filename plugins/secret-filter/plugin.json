{
  "id": "secret-filter",
  "name": "Sensitive Content Protection",
  "name_i18n": {
    "zh": "敏感内容保护",
    "zh_TW": "敏感內容保護",
    "ja": "機密情報の保護",
    "ko": "민감 정보 보호"
  },
  "version": "0.5.0",
  "api_version": 2,
  "type": "extension",
  "command": "secret-filter.exe",
  "contributes": {
    "hooks": [
      {
        "event": "clipboard.before_capture",
        "content_types": [
          "text"
        ]
      }
    ]
  }
}
