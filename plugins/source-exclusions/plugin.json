{
  "id": "source-exclusions",
  "name": "Ignored Applications",
  "name_i18n": {
    "zh": "忽略指定应用",
    "zh_TW": "忽略指定應用程式",
    "ja": "除外するアプリ",
    "ko": "제외할 앱"
  },
  "version": "0.4.0",
  "api_version": 2,
  "type": "extension",
  "command": "source-exclusions.exe",
  "settings": [
    {
      "key": "ignored_apps",
      "type": "multiline",
      "label": "Applications to ignore (one executable name per line)",
      "label_i18n": {
        "zh": "忽略的应用（每行一个程序名，如 example.exe）",
        "zh_TW": "忽略的應用程式（每行一個程式名稱，如 example.exe）",
        "ja": "除外するアプリ（1 行に 1 つの実行ファイル名）",
        "ko": "제외할 앱 (한 줄에 실행 파일 이름 하나)"
      }
    }
  ],
  "contributes": {
    "hooks": [
      {
        "event": "clipboard.before_capture",
        "content_types": [
          "text",
          "image",
          "file",
          "custom"
        ]
      }
    ]
  }
}
