{
  "id": "markdown-preview",
  "name": "Markdown Preview",
  "version": "0.4.0",
  "api_version": 2,
  "type": "extension",
  "command": "markdown-preview.exe",
  "contributes": {
    "commands": [
      "render"
    ],
    "clipboard": {
      "preview": {
        "command": "render",
        "content_types": [
          "file"
        ]
      }
    }
  }
}
