{
  "id": "format-inspector",
  "name": "Format Inspector",
  "version": "0.4.0",
  "api_version": 2,
  "type": "extension",
  "command": "format-inspector.exe",
  "contributes": {
    "commands": [
      "render"
    ],
    "clipboard": {
      "preview": {
        "command": "render",
        "content_types": [
          "text",
          "image",
          "file",
          "custom"
        ],
        "formats": [
          "*"
        ],
        "modes": [
          "formats"
        ]
      }
    }
  }
}
