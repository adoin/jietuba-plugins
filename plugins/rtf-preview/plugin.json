{
  "id": "rtf-preview",
  "name": "RTF Preview",
  "version": "0.5.0",
  "api_version": 2,
  "type": "extension",
  "command": "rtf-preview.exe",
  "contributes": {
    "commands": [
      "render"
    ],
    "clipboard": {
      "preview": {
        "command": "render",
        "content_types": [
          "text",
          "custom"
        ],
        "formats": [
          "Rich Text Format"
        ],
        "priority": 100
      }
    }
  }
}
